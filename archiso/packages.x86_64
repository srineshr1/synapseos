# ---- Installer ----
calamares
# /usr/bin/calamares links libKF6Crash.so.6, but the calamares package in
# archiso/repo/ does not declare kcrash in its depends. Without this line the
# binary dies in the dynamic loader before it can log anything, which looks
# like the installer doing nothing at all.
kcrash
# Calamares is Qt6: without this plugin it cannot open a window on Wayland.
qt6-wayland
# Lets grub-mkconfig add entries for other operating systems on the disk.
os-prober
# NOTE: the plasmalnf module additionally needs kconfig + kpackage, and
# displaymanager needs python-toml. Neither is used by settings.conf, so those
# packages are deliberately not shipped.

