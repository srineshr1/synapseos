---
componentName: synapseos

# --- Window -----------------------------------------------------------------
welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 900px,550px
windowPlacement: center

# --- Panels -----------------------------------------------------------------
sidebar: widget
navigation: widget

# --- Strings ----------------------------------------------------------------
strings:
  productName: SynapseOS
  shortProductName: SynapseOS
  version: 1.0
  shortVersion: 1.0
  versionedName: SynapseOS 1.0 "Initial"
  shortVersionedName: SynapseOS 1.0
  bootloaderEntryName: SynapseOS
  productUrl: https://github.com/SynapseOs
  supportUrl: https://github.com/SynapseOs
  knownIssuesUrl: https://github.com/SynapseOs
  releaseNotesUrl: https://github.com/SynapseOs
  donateUrl: ""
  productWelcome: >-
    Welcome to the SynapseOS installer. SynapseOS is an Arch Linux based
    distribution built around the COSMIC desktop. This installer copies the
    live system to your disk and sets up the bootloader, your user account
    and networking for you.

# --- Images (all five keys are mandatory) -----------------------------------
images:
  productBanner: "banner.png"
  productIcon: "icon.png"
  productLogo: "logo.png"
  productWallpaper: "wallpaper.png"
  productWelcome: "welcome.png"

# --- Slideshow --------------------------------------------------------------
slideshow: "slideshow/SynapseOS.qml"
slideshowAPI: 2

# --- Colours ----------------------------------------------------------------
# NOTE: these keys are capitalised in Calamares 3.4; lowercase variants are
# silently ignored.
style:
  SidebarBackground: "#101624"
  SidebarText: "#8c9cb4"
  SidebarBackgroundCurrent: "#1b2436"
  SidebarTextCurrent: "#e8eef7"
