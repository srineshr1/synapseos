# Defaults for the *installed* system. The live medium's boot menu is not built
# from this file (see archiso/grub/ and archiso/syslinux/), so values here are
# chosen for a normal disk boot. Calamares' grubcfg module updates
# GRUB_DISTRIBUTOR and the kernel command line during installation.
GRUB_DEFAULT="saved"
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE="menu"
GRUB_DISTRIBUTOR="SynapseOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3"
GRUB_CMDLINE_LINUX=""
GRUB_PRELOAD_MODULES="part_gpt part_msdos"
GRUB_TERMINAL_INPUT="console"
GRUB_TERMINAL_OUTPUT="gfxterm"
GRUB_GFXMODE="1920x1080x32,1920x1080,1366x768,1280x720,1024x768x32,1024x768,800x600,auto"
GRUB_GFXPAYLOAD_LINUX="keep"
GRUB_THEME="/usr/share/grub/themes/synapseos/theme.txt"
GRUB_COLOR_NORMAL="white/black"
GRUB_COLOR_HIGHLIGHT="white/blue"
GRUB_DISABLE_RECOVERY="true"
