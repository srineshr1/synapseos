#!/usr/bin/env bash
# One-click local databases in Docker, bound to localhost.
set -euo pipefail
# shellcheck source=/usr/share/synapseos/lib.sh
for _sos_lib in /usr/share/synapseos/lib.sh "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib.sh" "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"; do
    [[ -f $_sos_lib ]] && { source "$_sos_lib"; break; }
done
unset _sos_lib

options=(MySQL PostgreSQL Redis MongoDB MariaDB MSSQL)

if (( $# == 0 )); then
    mapfile -t choices < <(synapseos_pick "Select database (esc to cancel)" "${options[@]}" || true)
else
    choices=("$@")
fi

if (( ${#choices[@]} == 0 )); then
    echo "No databases selected."
    exit 0
fi

synapseos_have docker || { echo "synapseos: docker is not installed" >&2; exit 1; }

for db in "${choices[@]}"; do
    echo "Installing $db..."
    case "$db" in
        MySQL)
            synapseos_sudo docker run -d --restart unless-stopped \
                -p 127.0.0.1:3306:3306 --name=mysql8 \
                -e MYSQL_ROOT_PASSWORD= -e MYSQL_ALLOW_EMPTY_PASSWORD=true \
                mysql:8.4
            ;;
        PostgreSQL)
            synapseos_sudo docker run -d --restart unless-stopped \
                -p 127.0.0.1:5432:5432 --name=postgres18 \
                -e POSTGRES_HOST_AUTH_METHOD=trust \
                postgres:18
            ;;
        MariaDB)
            synapseos_sudo docker run -d --restart unless-stopped \
                -p 127.0.0.1:3306:3306 --name=mariadb11 \
                -e MARIADB_ROOT_PASSWORD= -e MARIADB_ALLOW_EMPTY_ROOT_PASSWORD=true \
                mariadb:11.8
            ;;
        Redis)
            synapseos_sudo docker run -d --restart unless-stopped \
                -p 127.0.0.1:6379:6379 --name=redis redis:7
            ;;
        MongoDB)
            synapseos_sudo docker run -d --restart unless-stopped \
                -p 127.0.0.1:27017:27017 --name=mongodb \
                -e MONGO_INITDB_ROOT_USERNAME=admin \
                -e MONGO_INITDB_ROOT_PASSWORD=admin123 \
                mongo:noble
            ;;
        MSSQL)
            synapseos_sudo docker run -d --restart unless-stopped \
                -p 127.0.0.1:1433:1433 --name=mssql \
                -e MSSQL_PID=Developer -e ACCEPT_EULA=Y \
                -e 'MSSQL_SA_PASSWORD=@dmin123' \
                mcr.microsoft.com/mssql/server:2022-CU12-ubuntu-22.04
            ;;
        *)
            echo "Unknown database: $db" >&2
            exit 2
            ;;
    esac
done

synapseos_done
