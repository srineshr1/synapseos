#!/usr/bin/env bash
# Toggle session features on Hyprland.
set -euo pipefail
# shellcheck source=/usr/share/synapseos/lib.sh
for _sos_lib in /usr/share/synapseos/lib.sh "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../lib.sh" "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"; do
    [[ -f $_sos_lib ]] && { source "$_sos_lib"; break; }
done
unset _sos_lib

usage() {
    cat <<'EOF'
Usage: synapseos toggle <feature>

  floating | float   Toggle floating for the active window
EOF
}

cmd="${1:-}"
case "$cmd" in
    floating|float|tiling|hyprland|tile|wm)
        if synapseos_have hyprctl; then
            hyprctl dispatch togglefloating >/dev/null
        else
            echo "synapseos: hyprctl not found" >&2
            exit 1
        fi
        ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        echo "synapseos toggle: unknown feature '$cmd'" >&2
        usage >&2
        exit 2
        ;;
esac
