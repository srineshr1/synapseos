#!/usr/bin/env bash
# Print Hyprland + Caelestia session state. Run as the desktop user.
set -u

echo "=== fonts ==="
fc-list | grep -i 'JetBrainsMono Nerd Font' | head -5 || echo "NO JetBrains families visible to fontconfig"
fc-list | grep -i 'Material Symbols' | head -2 || echo "NO Material Symbols (Caelestia icons)"

echo
echo "=== session ==="
printf 'XDG_CURRENT_DESKTOP=%s\n' "${XDG_CURRENT_DESKTOP:-unset}"
printf 'XDG_SESSION_TYPE=%s\n' "${XDG_SESSION_TYPE:-unset}"
printf 'HYPRLAND_INSTANCE_SIGNATURE=%s\n' "${HYPRLAND_INSTANCE_SIGNATURE:-unset}"
printf 'virtualisation=%s\n' "$(systemd-detect-virt 2>/dev/null || echo none)"
printf 'WLR_RENDERER=%s\n' "${WLR_RENDERER:-unset}"
printf 'QT_QUICK_BACKEND=%s\n' "${QT_QUICK_BACKEND:-unset}"
printf 'QSG_RHI_BACKEND=%s\n' "${QSG_RHI_BACKEND:-unset}"
printf 'AQ_NO_MODIFIERS=%s\n' "${AQ_NO_MODIFIERS:-unset}"

echo
echo "=== hyprctl ==="
if command -v hyprctl >/dev/null; then
    hyprctl version 2>/dev/null | head -5 || true
    echo "clients: $(hyprctl -j clients 2>/dev/null | wc -c) bytes"
else
    echo "hyprctl not found"
fi

echo
echo "=== caelestia ==="
command -v caelestia >/dev/null && caelestia -v 2>/dev/null || echo "caelestia CLI missing"
pgrep -a -f 'qs|quickshell|caelestia' | head -10 || echo "(no shell process)"

echo
echo "=== wallpaper ==="
if [[ -f /usr/share/backgrounds/synapseos/desktop.png ]]; then
    echo "stock wallpaper: /usr/share/backgrounds/synapseos/desktop.png"
else
    echo "WARN: stock wallpaper missing"
fi

if [[ "${WLR_RENDERER:-}" == pixman ]]; then
    echo "WARN: software compositor — GPU blur cannot run. Reboot without safegfx,"
    echo "      or: sudo synapseos-safe-graphics off && loginctl terminate-user $USER"
fi
if [[ "${QT_QUICK_BACKEND:-}" == software ]]; then
    echo "note: software Qt Quick (VM workaround for virgl dmabuf import)"
fi

echo
echo "=== recent compositor errors ==="
journalctl --user -b --no-pager -n 80 2>/dev/null \
    | grep -Ei 'hyprland|quickshell|caelestia' | tail -20 \
    || true
if [[ -f "${XDG_CACHE_HOME:-$HOME/.cache}/synapseos/session.log" ]]; then
    echo "-- session.log --"
    grep -Ei 'error|fail|hypr' \
        "${XDG_CACHE_HOME:-$HOME/.cache}/synapseos/session.log" | tail -20
fi
