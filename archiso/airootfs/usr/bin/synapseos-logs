#!/usr/bin/env bash
# Collect everything needed to debug a failed live boot / desktop / install into
# one file, and copy it to a writable USB stick if one is given.
#
#   synapseos-logs                  # writes ~/synapseos-logs-<host>-<date>.txt
#   synapseos-logs /run/media/live/MYSTICK
#
# The live journal is volatile (Storage=volatile), so it lives in RAM only:
# collect it before rebooting or it is gone.
set -uo pipefail

dest_dir="${1:-$HOME}"
out="$dest_dir/synapseos-logs-$(hostname)-$(date +%Y%m%d-%H%M%S).txt"

section() { printf '\n\n===== %s =====\n' "$1"; }
have() { command -v "$1" > /dev/null 2>&1; }

{
    echo "SynapseOS diagnostics"
    echo "date:    $(date -Is)"
    echo "kernel:  $(uname -srm)"
    echo "cmdline: $(cat /proc/cmdline)"

    section "ISO / release"
    cat /etc/os-release 2> /dev/null
    cat /run/archiso/bootmnt/*/version 2> /dev/null

    section "failed units"
    systemctl --no-pager --failed
    section "failed user units"
    systemctl --user --no-pager --failed 2> /dev/null

    section "journal, current boot (priority warning and above)"
    journalctl -b -p warning --no-pager 2> /dev/null

    section "journal, current boot (full)"
    journalctl -b --no-pager 2> /dev/null

    section "previous boot (warnings and above)"
    journalctl -b -1 -p warning --no-pager 2> /dev/null \
        || echo "(no previous boot in the journal)"

    section "crashes: coredumpctl"
    # systemd-coredump is enabled by default, so a cosmic-comp segfault lands
    # here with a backtrace - this is the file to look at when the desktop
    # restarts and takes every window with it.
    if have coredumpctl; then
        coredumpctl list --no-pager 2> /dev/null | tail -n 25
        for prog in kwin_wayland kwin_x11 plasmashell sddm; do
            if coredumpctl info "$prog" > /dev/null 2>&1; then
                section "coredumpctl info $prog (most recent)"
                coredumpctl info "$prog" 2> /dev/null | head -n 120
            fi
        done
    else
        echo "(coredumpctl not available)"
    fi

    section "compositor messages this boot"
    journalctl -b --no-pager _COMM=kwin_wayland 2> /dev/null | tail -n 100
    journalctl -b --no-pager _COMM=plasmashell 2> /dev/null | tail -n 80
    journalctl -b --no-pager -u sddm 2> /dev/null | tail -n 80

    section "compositor workaround variables"
    printf 'KWIN_COMPOSE=%s\n' "${KWIN_COMPOSE:-unset}"
    have systemd-detect-virt && echo "virtualisation: $(systemd-detect-virt)"

    section "plasma-session log"
    cat "${XDG_CACHE_HOME:-$HOME/.cache}/synapseos/plasma-session.log" 2> /dev/null \
        || echo "(no plasma-session log - the desktop was never started from tty1)"

    section "calamares log"
    cat "$HOME/.cache/calamares/session.log" 2> /dev/null \
        || echo "(no calamares log - the installer has not been run)"

    section "graphics"
    have lspci && lspci -nnk | grep -A3 -Ei 'vga|3d|display'
    ls -l /dev/dri 2> /dev/null || echo "(no /dev/dri - no KMS driver bound)"
    have loginctl && loginctl list-seats
    have loginctl && loginctl list-sessions

    section "dmesg: drm / firmware / acpi errors"
    dmesg 2> /dev/null | grep -Ei 'drm|firmware|error|fail' | tail -n 200

    section "block devices"
    lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS
    section "mounts"
    findmnt -no TARGET,SOURCE,FSTYPE,OPTIONS
    section "memory"
    free -h
    section "network"
    have nmcli && nmcli -t device status
} > "$out" 2>&1

sync
echo "wrote $out ($(du -h "$out" | cut -f1))"
echo
echo "To get it off this machine, plug in a USB stick and re-run:"
echo "    synapseos-logs /run/media/live/<STICK>"
