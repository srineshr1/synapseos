#!/usr/bin/env bash
# Force KWin onto OpenGL and load blur. Run as the desktop user.
set -u

# Do not set KWIN_COMPOSE=O — KWin exits if OpenGL cannot start.
export KWIN_DISABLE_VULKAN="${KWIN_DISABLE_VULKAN:-1}"

ENVDIR="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-workspace/env"
mkdir -p "$ENVDIR"
printf '%s\n' 'export KWIN_DISABLE_VULKAN=1' > "$ENVDIR/synapseos-compose.sh"
chmod +x "$ENVDIR/synapseos-compose.sh"

if command -v qdbus6 >/dev/null; then
    dbus=qdbus6
elif command -v qdbus >/dev/null; then
    dbus=qdbus
else
    echo "qdbus6 not found" >&2
    exit 1
fi

wait_kwin() {
    local i
    for i in $(seq 1 30); do
        $dbus org.kde.KWin /KWin >/dev/null 2>&1 && return 0
        sleep 0.4
    done
    return 1
}

load_blur() {
    # Better Blur DX lies on virgl: it reports "Effect supported" but
    # composites nothing, so a VM always gets stock blur + frost.
    if in_vm; then
        $dbus org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect better_blur_dx >/dev/null 2>&1 || true
        kw --file kwinrc --group Plugins --key better_blur_dxEnabled false
        kw --file kwinrc --group Plugins --key blurEnabled true
    else
        kw --file kwinrc --group Plugins --key blurEnabled true
        kw --file kwinrc --group Plugins --key better_blur_dxEnabled true
    fi
    $dbus org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect blur >/dev/null 2>&1 || true
    $dbus org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect better_blur_dx >/dev/null 2>&1 || true
    $dbus org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect synapseosfrost >/dev/null 2>&1 || true
    $dbus org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
}

blur_loaded() {
    local v
    v="$($dbus org.kde.KWin /Effects org.kde.kwin.Effects.isEffectLoaded blur 2>/dev/null || true)"
    [[ "$v" == *true* ]] && return 0
    in_vm && return 1
    v="$($dbus org.kde.KWin /Effects org.kde.kwin.Effects.isEffectLoaded better_blur_dx 2>/dev/null || true)"
    [[ "$v" == *true* ]]
}

in_vm() {
    command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt -q
}

kw() {
    if command -v kwriteconfig6 >/dev/null; then
        kwriteconfig6 "$@"
    elif command -v kwriteconfig5 >/dev/null; then
        kwriteconfig5 "$@"
    fi
}

replace_kwin() {
    kwin_wayland --replace >/tmp/synapseos-kwin-replace.log 2>&1 &
    disown
    wait_kwin
}

ctype="$($dbus org.kde.KWin /Compositor org.kde.kwin.Compositing.compositingType 2>/dev/null || echo unknown)"
echo "compositingType=$ctype  KWIN_DISABLE_VULKAN=$KWIN_DISABLE_VULKAN"

if blur_loaded; then
    load_blur
    echo "blur already loaded"
    exit 0
fi

echo "replacing kwin (KWIN_DISABLE_VULKAN=1, no fatal KWIN_COMPOSE)"
replace_kwin
load_blur
ctype="$($dbus org.kde.KWin /Compositor org.kde.kwin.Compositing.compositingType 2>/dev/null || echo unknown)"
echo "after replace: compositingType=$ctype"

if blur_loaded; then
    echo "blur loaded"
    exit 0
fi

echo "OpenGL blur still failed — retrying with llvmpipe"
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
printf '%s\n' \
    'export KWIN_DISABLE_VULKAN=1' \
    'export LIBGL_ALWAYS_SOFTWARE=1' \
    'export GALLIUM_DRIVER=llvmpipe' \
    > "$ENVDIR/synapseos-compose.sh"
replace_kwin
load_blur
ctype="$($dbus org.kde.KWin /Compositor org.kde.kwin.Compositing.compositingType 2>/dev/null || echo unknown)"
echo "after llvmpipe: compositingType=$ctype"
if blur_loaded; then
    echo "blur loaded (software GL)"
    exit 0
fi

FROST_WALLPAPER=/usr/share/backgrounds/synapseos/desktop-frost.jpg
if [[ -f "$FROST_WALLPAPER" ]]; then
    echo "live blur unavailable — using pre-rendered frost wallpaper"
    $dbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        var img = 'file://${FROST_WALLPAPER}';
        var ds = desktops();
        for (var i = 0; i < ds.length; i++) {
            ds[i].wallpaperPlugin = 'org.kde.image';
            ds[i].currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
            ds[i].writeConfig('Image', img);
        }
    " >/dev/null 2>&1 || true
    exit 0
fi

echo "blur still not loaded. last kwin log:" >&2
tail -n 40 /tmp/synapseos-kwin-replace.log 2>/dev/null || true
echo "compositor support:" >&2
$dbus org.kde.KWin /KWin supportInformation 2>/dev/null \
    | grep -Ei 'composit|opengl|backend|render|vulkan|qpainter|software' \
    | head -n 30 || true
exit 1
